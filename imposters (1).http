# ==============================================================
# EXERCÍCIO 6 — POST /api/users — email duplicado → 409
# ==============================================================

### EX6 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex6",
  "port": 4006,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 409,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "error": "email_exists",
              "message": "O email já se encontra registado."
            }
          }
        }
      ],
      "predicates": [
        {
          "equals": {
            "path": "/api/users",
            "method": "POST",
            "headers": { "Content-Type": "application/json" }
          },
          "contains": {
            "body": "exists@example.com"
          }
        }
      ]
    }
  ]
}

###

### EX6 — Teste: email duplicado → 409
POST http://localhost:4006/api/users
Content-Type: application/json

{ "nome": "João Silva", "email": "exists@example.com", "idade": 30 }

###


# ==============================================================
# EXERCÍCIO 7 — POST /api/users — novo utilizador → 201 + Location
# ==============================================================

### EX7 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex7",
  "port": 4007,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 409,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "error": "email_exists",
              "message": "O email já se encontra registado."
            }
          }
        }
      ],
      "predicates": [
        {
          "equals": {
            "path": "/api/users",
            "method": "POST",
            "headers": { "Content-Type": "application/json" }
          },
          "contains": {
            "body": "exists@example.com"
          }
        }
      ]
    },
    {
      "responses": [
