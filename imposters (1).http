# ==============================================================
# EXERCÍCIO 4 — POST /api/login — credenciais válidas → 200 + token
# ==============================================================

### EX4 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex4",
  "port": 4004,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "status": "ok",
              "token": "validtoken"
            }
          }
        }
      ],
      "predicates": [
        {
          "deepEquals": {
            "path": "/api/login",
            "method": "POST",
            "headers": { "Content-Type": "application/json" },
            "body": { "username": "admin", "password": "secret" }
          }
        }
      ]
    }
  ]
}

###

### EX4 — Teste: credenciais correctas → 200 + token
POST http://localhost:4004/api/login
Content-Type: application/json

{ "username": "admin", "password": "secret" }

###


# ==============================================================
# EXERCÍCIO 5 — POST /api/login — credenciais inválidas → 401
# ==============================================================

### EX5 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex5",
  "port": 4005,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "status": "ok",
              "token": "validtoken"
            }
          }
        }
      ],
      "predicates": [
        {
          "deepEquals": {
            "path": "/api/login",
            "method": "POST",
            "headers": { "Content-Type": "application/json" },
            "body": { "username": "admin", "password": "secret" }
          }
        }
      ]
