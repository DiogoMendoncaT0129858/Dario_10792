# ==============================================================
# EXERCÍCIO 8 — POST /api/temperature — sem campo "value" → 400
# ==============================================================

### EX8 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex8",
  "port": 4008,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "error": "missing_field",
              "message": "O campo 'value' é obrigatório."
            }
          }
        }
      ],
      "predicates": [
        {
          "equals": {
            "path": "/api/temperature",
            "method": "POST",
            "headers": { "Content-Type": "application/json" }
          },
          "not": {
            "contains": { "body": "value" }
          }
        }
      ]
    }
  ]
}

