# =============================================================
# EXERCÍCIOS PRÁTICOS — IMPOSTERS (MOUNTEBANK)
# UC 00605 — Programar para a web (server-side)
# REST Client para VS Code
# Cada exercício cria o seu próprio imposter numa porta única
# =============================================================


# ==============================================================
# EXERCÍCIO 1 — GET /api/marcas → 200 + lista de marcas
# ==============================================================

### EX1 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex1",
  "port": 4001,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "marcas": ["BMW", "Honda", "Toyota"]
            }
          }
        }
      ],
      "predicates": [
        {
          "equals": {
            "path": "/api/marcas",
            "method": "GET",
            "headers": { "Content-Type": "application/json" }
          }
        }
      ]
    }
  ]
}

###

### EX1 — Teste: GET /api/marcas → 200 + array de marcas
GET http://localhost:4001/api/marcas
Content-Type: application/json

###


# ==============================================================
# EXERCÍCIO 2 — GET /api/cars?brand=Toyota → 200 + resultados
# ==============================================================

### EX2 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex2",
  "port": 4002,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "brand": "Toyota",
              "results": [
                { "id": 1, "modelo": "Corolla", "preco": 25000 },
                { "id": 2, "modelo": "Yaris",   "preco": 18000 },
                { "id": 3, "modelo": "RAV4",    "preco": 35000 }
              ]
            }
          }
        }
      ],
      "predicates": [
        {
          "equals": {
            "path": "/api/cars",
            "method": "GET",
            "query": { "brand": "Toyota" },
            "headers": { "Content-Type": "application/json" }
          }
        }
      ]
    }
  ]
}

###

### EX2 — Teste: GET /api/cars?brand=Toyota → 200 + resultados
GET http://localhost:4002/api/cars?brand=Toyota
Content-Type: application/json

###


