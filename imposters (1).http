# ==============================================================
# EXERCÍCIO 12 — POST /api/auth → 200 com user1/pass1, 401 noutros
# ==============================================================

### EX12 — Criar imposter
POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "ex12",
  "port": 4012,
  "protocol": "http",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "token": "validtoken",
              "expires_in": 3600
            }
          }
        }
      ],
      "predicates": [
        {
          "deepEquals": {
            "path": "/api/auth",
            "method": "POST",
            "headers": { "Content-Type": "application/json" },
            "body": { "username": "user1", "password": "pass1" }
          }
        }
      ]
    },
    {
      "responses": [
        {
          "is": {
            "statusCode": 401,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "error": "invalid_credentials"
            }
          }
        }
      ],
      "predicates": [
        {
          "equals": {
            "path": "/api/auth",
            "method": "POST",
            "headers": { "Content-Type": "application/json" }
          }
        }
      ]
    }
  ]
}

###

### EX12 — Teste positivo: user1/pass1 → 200 + token
